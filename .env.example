# Copiază acest fișier în `.env` și completează valorile.
# Aplicația funcționează complet fără nicio cheie externă: providerii
# demonstrativi acoperă transcrierea, OCR-ul, TTS-ul, Gmail și Calendar.

# --------------------------------------------------------------------- Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=schimba-ma
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# Cheie Fernet pentru criptarea tokenurilor OAuth în baza de date.
# Generează una cu: python manage.py genereaza_chei
TOKEN_ENCRYPTION_KEY=

# --------------------------------------------------------------- Provideri AI
# Fără AI_ENABLED=True, transcrierea și interpretarea folosesc providerii locali:
# parserul de comenzi în limba română funcționează complet offline.
AI_ENABLED=False
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_INTENT=gpt-4o-mini
OPENAI_MODEL_TRANSCRIBE=whisper-1
OPENAI_MODEL_TTS=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_MAX_RETRIES=2

# Alege implementarea fiecărui provider. Valorile implicite sunt cele
# demonstrative; comentariile arată variantele reale.
# PROVIDER_TRANSCRIPTION=apps.assistant.providers.openai_transcription.OpenAITranscriptionProvider
# PROVIDER_INTENT=apps.assistant.providers.openai_intent.OpenAIIntentParser
# PROVIDER_OCR=apps.documents.providers.rapid_ocr.RapidOCRProvider
# PROVIDER_OCR=apps.documents.providers.easy_ocr.EasyOCRProvider
# PROVIDER_TTS=apps.daily_brief.providers.openai_tts.OpenAITTSProvider
# PROVIDER_NOTIFICATION=apps.notifications.providers.webpush.WebPushProvider

# --------------------------------------------------------------------- OCR
OCR_LANGUAGES=ro,en
OCR_MAX_SIDE_PX=2000
OCR_FIELD_CONFIDENCE_WARN=0.65

# ------------------------------------------------------------------- Rezumat
# Reformularea AI a rezumatului este oprită implicit: textul determinist,
# construit direct din datele tale, este varianta livrată.
BRIEF_POLISH_ENABLED=False
BRIEF_AUDIO_ENABLED=True

# ------------------------------------------------------------------- Google
# Din Google Cloud Console → API & Services → Credentials → OAuth client ID
# (tip „Web application"). Vezi README pentru scope-urile necesare.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/integrari/google/callback/
# metadata = permisiuni minime (fără fragmente de text) | readonly = cu fragmente
GMAIL_SCOPE_LEVEL=metadata

# --------------------------------------------------------------- Notificări
# Generează perechea cu: python manage.py genereaza_chei
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=

# ------------------------------------------------------------------- Celery
# În dev taskurile rulează sincron, deci Redis nu este necesar.
CELERY_TASK_ALWAYS_EAGER=True
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# ---------------------------------------------------------------- Aplicație
TRASH_RETENTION_DAYS=30
VOICE_AUDIO_RETENTION_DAYS=7
DRAFT_TTL_MINUTES=60
MAX_UPLOAD_IMAGE_BYTES=12582912
MAX_UPLOAD_AUDIO_BYTES=20971520
INTENT_CONFIDENCE_AUTOFILL=0.55
INTENT_CONFIDENCE_CLARIFY=0.40

# Limite de rată: număr maxim de cereri și fereastra în secunde.
RATE_VOICE_MAX=20
RATE_VOICE_WINDOW=300
RATE_OCR_MAX=20
RATE_OCR_WINDOW=300
RATE_AI_MAX=30
RATE_AI_WINDOW=300
RATE_SEARCH_MAX=120
RATE_SEARCH_WINDOW=60

# ----------------------------------------------------------------- Producție
# DJANGO_SETTINGS_MODULE=config.settings.prod
# DJANGO_DEBUG=False
# DJANGO_CSRF_TRUSTED_ORIGINS=https://asistent.example.com
# DJANGO_SECURE_SSL_REDIRECT=True
# POSTGRES_DB=voicetask
# POSTGRES_USER=voicetask
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_CACHE_URL=redis://127.0.0.1:6379/1
# CELERY_TASK_ALWAYS_EAGER=False
# SW_CACHE_VERSION=2
